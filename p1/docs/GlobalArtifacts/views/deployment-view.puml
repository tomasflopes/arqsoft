@startuml deployment-view

node "App Server" {
  component "Backend App" as APP
  component "ID Generator A" as ID_GEN_A
  component "ID Generator B" as ID_GEN_B
}

node "SQL Server" {
  database "SQL DB" as SQL_DB
  interface "Persistence API (SQL)" as PERSIST_SQL
}

node "Mongo Server" {
  database "Mongo DB" as MONGO_DB
  interface "Persistence API (Mongo)" as PERSIST_MONGO
}

node "Redis Server" {
  database "Redis Cache" as REDIS
}

cloud "ISBN Services" {
  component "ISBN Service A" as ISBN_A
  component "ISBN Service B" as ISBN_B
}

APP --> PERSIST_SQL : uses
APP --> PERSIST_MONGO : uses
PERSIST_SQL --> SQL_DB
PERSIST_MONGO --> MONGO_DB

APP --> REDIS : cache

APP --> ISBN_A : uses
APP --> ISBN_B : uses (alternative)

APP --> ID_GEN_A : uses
APP --> ID_GEN_B : uses (alternative)

@enduml