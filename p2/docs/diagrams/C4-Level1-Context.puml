@startuml C4_Context_Diagram
!include <C4/C4_Context>

title System Context Diagram - Library Management System (LMS)

Person(librarian, "Librarian", "Gestor da biblioteca que administra livros, leitores e empréstimos")
Person(reader, "Reader", "Utilizador que requisita livros e consulta informações")

System_Boundary(lms, "Library Management System") {
    System(lms_system, "LMS Microservices", "Sistema distribuído de gestão de biblioteca baseado em microserviços")
}

System_Ext(rabbitmq, "RabbitMQ", "Message broker para comunicação assíncrona entre microserviços")
System_Ext(dbs, "PostgreSQL/MySQL", "Base de dados relacional por serviço (Genres usa MySQL; restantes PostgreSQL)")

Rel(librarian, lms_system, "Gere catálogo, leitores e empréstimos", "HTTPS/REST")
Rel(reader, lms_system, "Consulta livros e requisita empréstimos", "HTTPS/REST")

Rel(lms_system, rabbitmq, "Publica e consome eventos", "AMQP")
Rel(lms_system, dbs, "Persiste dados", "JDBC")

@enduml
